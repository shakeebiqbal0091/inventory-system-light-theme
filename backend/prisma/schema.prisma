// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User / Auth ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STAFF
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  stockMovements StockMovement[]
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings UserSettings?

  @@map("users")
}

enum POStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

model PurchaseOrder {
  id           String   @id @default(cuid())
  poNumber     String   @unique
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  orderDate    DateTime @default(now())
  expectedDate DateTime?
  status       POStatus @default(DRAFT)
  notes        String?
  items        PurchaseOrderItem[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  quantityOrdered  Int
  quantityReceived Int @default(0)
  unitCost         Float
  damagedCount     Int @default(0)
  qualityNotes     String?

  @@map("purchase_order_items")
}

// ─── Inventory ────────────────────────────────────────────────────────────────

model Product {
  id                String    @id @default(cuid())
  name              String
  category          String
  price             Float
  costPrice         Float     @default(0)
  quantity          Int       @default(0)
  lowStockThreshold Int       @default(10)
  supplier          String?
  description       String?
  stockLocations StockLocation[]
  stockMovements StockMovement[]
  purchaseOrderItems  PurchaseOrderItem[]   // ← add
  lastAlertedAt     DateTime? // ← added: null = no active alert, set = alert already sent
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  supplierId        String?
  supplierRef       Supplier? @relation(fields: [supplierId], references: [id])

  sales Sale[]

  @@map("products")
}

// ─── Sales ────────────────────────────────────────────────────────────────────

model Sale {
  id         String   @id @default(cuid())
  productId  String
  quantity   Int
  totalPrice Float // selling price × qty
  totalCost  Float    @default(0) // cost price × qty
  profit     Float    @default(0) // totalPrice − totalCost
  createdAt  DateTime @default(now())
  salesOrderId String?
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])
  returns      Return[]
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("sales")
}

model Supplier {
  id            String   @id @default(cuid())
  companyName   String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  purchaseOrders PurchaseOrder[]   // ← add
  paymentTerms  String? // e.g. "Net 30"
  leadTimeDays  Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products Product[]

  @@map("suppliers")
}

model Customer {
  id              String   @id @default(cuid())
  name            String
  company         String?
  email           String?
  phone           String?
  shippingAddress String?
  billingAddress  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  salesOrders SalesOrder[]
  @@map("customers")
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique

  currency          String @default("USD")
  lowStockThreshold Int    @default(10)
  dateFormat        String @default("MM/DD/YYYY")

  businessName    String?
  businessEmail   String?
  businessPhone   String?
  businessAddress String?

  lowStockAlerts     Boolean @default(true)
  salesNotifications Boolean @default(true)
  emailNotifications Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

enum OrderChannel {
  ONLINE
  IN_STORE
  WHOLESALE
}

enum OrderStatus {
  PENDING
  PACKING
  SHIPPED
  CANCELLED
}

enum ReturnDisposition {
  RESTOCK
  WRITE_OFF
}

model SalesOrder {
  id          String       @id @default(cuid())
  orderNumber String       @unique
  customerId  String?
  customer    Customer?    @relation(fields: [customerId], references: [id])
  channel     OrderChannel @default(IN_STORE)
  status      OrderStatus  @default(PENDING)
  orderDate   DateTime     @default(now())
  notes       String?
  sales       Sale[]
  shipment    Shipment?
  returns     Return[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("sales_orders")
}

model Shipment {
  id               String     @id @default(cuid())
  salesOrderId     String     @unique
  salesOrder       SalesOrder @relation(fields: [salesOrderId], references: [id])
  carrierName      String?
  trackingNumber   String?
  shipDate         DateTime?
  packingSlipNotes String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@map("shipments")
}

model Return {
  id           String             @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder         @relation(fields: [salesOrderId], references: [id])
  saleId       String?
  sale         Sale?              @relation(fields: [saleId], references: [id])
  reason       String
  disposition  ReturnDisposition  @default(RESTOCK)
  quantity     Int
  createdAt    DateTime           @default(now())

  @@map("returns")
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  address   String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockLocations StockLocation[]

  @@map("warehouses")
}

model StockLocation {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  quantity    Int       @default(0)
  aisle       String?
  shelf       String?
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId])
  @@map("stock_locations")
}


enum MovementType {
  SALE
  PURCHASE_RECEIPT
  TRANSFER_OUT
  TRANSFER_IN
  RETURN_RESTOCK
  MANUAL_ADJUSTMENT
}

model StockMovement {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      MovementType
  quantity  Int
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  note      String?
  createdAt DateTime     @default(now())

  @@map("stock_movements")
}