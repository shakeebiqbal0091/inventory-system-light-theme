# Database - replace with your PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/inventory_db"

# JWT Secret - change this to a long random string in production
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=development

# CORS - your frontend URL
FRONTEND_URL="http://localhost:3000"

# Email (SMTP) - used for low-stock alerts and weekly summaries
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Inventory Pro <alerts@yourdomain.com>"

# Anthropic API - used for AI-generated weekly business summaries
ANTHROPIC_API_KEY="sk-ant-..."